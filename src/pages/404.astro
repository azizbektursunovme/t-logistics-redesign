---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';
import { url } from '../lib/url';
---
<Base title="Page not found | T-LOGISTICS Inc" description="This page does not exist." noindex>
  <section class="page-hero page-hero--plain">
    <div class="wrap page-hero__inner">
      <h1>This page does not exist</h1>
      <p class="lede">The link may be old or mistyped. Go to the home page, request a quote, or call dispatch at {company.phone}.</p>
      <div class="btn-row">
        <a class="btn btn--white" href={url('/')}>Go to the home page</a>
        <a class="btn btn--light" href={url('quote/')}>Get a quote</a>
      </div>
    </div>
  </section>
</Base>
