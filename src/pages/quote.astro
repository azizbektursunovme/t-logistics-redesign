---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { company, links, fullAddress } from '../data/site';
import { url } from '../lib/url';
---
<Base
  title="Request a freight quote | T-LOGISTICS Inc"
  description={`Request a dry van freight quote from T-LOGISTICS Inc, or reach dispatch 24/7 at ${company.phone}.`}
  current="quote"
>
  <section class="page-hero">
    <Photo name="band-expedited" widths={[800, 1600]} sizes="100vw" width={1600} height={900} alt="" eager />
    <div class="wrap page-hero__inner">
      <h1>Request a freight quote</h1>
      <p class="lede">Tell us where the load picks up, where it delivers and what is in the trailer. Dispatch replies by phone or email.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap form-layout">
      <QuoteForm />

      <aside class="dispatch-card" id="contact" aria-labelledby="contact-title">
        <div>
          <h2 id="contact-title">Talk to dispatch</h2>
          <p>Prefer the phone? Dispatch answers 24/7. Call for same-day loads.</p>
        </div>
        <a class="dispatch-card__phone" href={company.phoneHref}>
          <span class="dispatch-card__icon"><Icon name="phone" /></span>{company.phone}
        </a>
        <ul class="dispatch-list">
          <li>
            <Icon name="mail" />
            <div><span>Email</span><a href={`mailto:${company.email}`}>{company.email}</a></div>
          </li>
          <li>
            <Icon name="pin" />
            <div><span>Office</span><a href={links.maps} target="_blank" rel="noopener">{fullAddress}</a></div>
          </li>
          <li>
            <Icon name="shield" />
            <div><span>Operating authority</span><strong>USDOT {company.dot}, MC {company.mc}</strong></div>
          </li>
        </ul>
        <p class="dispatch-card__note">Looking for a driving job? This form is for shippers. <a href={url('drivers/#apply')}>Apply on the drivers page</a>.</p>
      </aside>
    </div>
  </section>
</Base>
